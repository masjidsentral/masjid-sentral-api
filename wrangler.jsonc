{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  // Masjid Sentral account (owner 2026-11-17), NOT the JM account 0283b7...
  "account_id": "7e72c27f3de3f130ec221a937ac22557",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-29",
  "vars": {
    "IMAGES_ACCOUNT_ID": "PENDING",
    "IMAGES_DELIVERY_URL": "https://imagedelivery.net/PENDING"
  },
  "routes": [{ "pattern": "api.masjidsentral.com", "custom_domain": true }],
  "triggers": { "crons": ["* * * * *", "0 * * * *"] },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // Fresh D1 for the v1.1 rebuild (owner creates it; see PROGRESS_app-sync.md checklist).
      // The old D1 masjidsentral (28e4a5dc-18d5-4d5c-a080-c629179764ad) stays untouched as the backup.
      "database_name": "masjidsentral-v2",
      "database_id": "REPLACE_WITH_NEW_D1_ID",
      "migrations_dir": "../masjidsentral-db-schema/migrations"
    }
  ]
}
